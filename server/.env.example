PORT=8787
NODE_ENV=production
# Configure these on your relay and signaling host, never in EXPO_PUBLIC_*.
TURN_URLS=turn:relay.your-domain.example:3478,turns:relay.your-domain.example:5349
TURN_SECRET=replace-with-your-relay-shared-secret

# Optional online AI speech and authorized personal voice cloning.
# For local Expo development, put these in server/.env.local and restart npm start.
ELEVENLABS_API_KEY=
# Required for AI voice endpoints in production. Enter the same access key
# in the app's Voice → Service connection screen; it is kept in secure storage.
VOICE_SERVICE_TOKEN=
# Optional overrides for the available male/female voices in your provider account.
# When unset, the service discovers current default voices by their gender labels.
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Persistent private directory in production; mount it as a volume in Docker.
# VOICE_DATA_DIR=/app/voice-data
# FFMPEG_PATH=/usr/local/bin/ffmpeg
